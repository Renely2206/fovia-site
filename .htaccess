# FOVIA — configuration serveur (hébergement mutualisé Apache classique)
# À adapter si l'hébergement final est Netlify / Vercel / autre (voir README.txt).

# 1. Forcer HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Forcer la version sans "www." (aligné sur les URLs canoniques https://fovia.fr/)
  RewriteCond %{HTTP_HOST} ^www\.fovia\.fr$ [NC]
  RewriteRule ^(.*)$ https://fovia.fr/$1 [L,R=301]
</IfModule>

# 2. Page 404 personnalisée
ErrorDocument 404 /404.html

# 3. En-têtes de sécurité de base
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Compression (vitesse de page)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# 5. Cache navigateur (vitesse de page)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
